{
  "adcm": {
    "uuid": "uuid_stub",
    "config": {
      "global": {
        "adcm_url": null,
        "verification_public_key": "{{ filedir }}/adcm.{{ adcm_id }}.global.verification_public_key",
        "accept_only_verified_bundles": false
      },
      "statistics_collection": {
        "url": "adcm-usage-ss.arenadata.io"
      },
      "audit_data_retention": {
        "log_rotation_on_fs": 365,
        "log_rotation_in_db": 365,
        "config_rotation_in_db": 0,
        "retention_period": 1825,
        "data_archiving": false
      },
      "ldap_integration": null,
      "auth_policy": {
        "min_password_length": 12,
        "max_password_length": 20,
        "login_attempt_limit": 5,
        "block_time": 5
      }
    }
  },
  "context": {
    "service_id": {{ service.id }},
    "cluster_id": {{ cluster.id }},
    "type": "service"
  },
  "env": {
    "run_dir": "{{ datadir }}/run",
    "log_dir": "{{ datadir }}/log",
    "tmp_dir": "{{ datadir }}/run/{{ job_id }}/tmp",
    "stack_dir": "{{ bundledir }}/{{ cluster_bundle.hash }}",
    "status_api_token": "{{ token }}",
    "consul_url": null,
    "consul_datacenter": null,
    "consul_cacert_file": null
  },
  "job": {
    "id": {{ job_id }},
    "action": "job_bundle_relative",
    "job_name": "job_bundle_relative",
    "command": "job_bundle_relative",
    "script": "scripts/over_there.yaml",
    "verbose": false,
    "playbook": "{{ bundledir }}/{{ cluster_bundle.hash }}/scripts/over_there.yaml",
    "cluster_id": {{ cluster.id }},
    "hostgroup": "as_cluster",
    "service_id": {{ service.id }},
    "service_type_id": {{ service_type_id }}
  },
  "process": null
}
